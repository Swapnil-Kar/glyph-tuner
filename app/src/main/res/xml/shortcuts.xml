<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: Start tuner / Stop tuner. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="start"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_start"
        android:shortcutShortLabel="@string/shortcut_start"
        android:shortcutLongLabel="@string/shortcut_start">
        <intent
            android:action="com.glyphtuner.action.START"
            android:targetPackage="com.glyphtuner"
            android:targetClass="com.glyphtuner.StartActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="stop"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_stop"
        android:shortcutShortLabel="@string/shortcut_stop"
        android:shortcutLongLabel="@string/shortcut_stop">
        <intent
            android:action="com.glyphtuner.action.STOP"
            android:targetPackage="com.glyphtuner"
            android:targetClass="com.glyphtuner.StartActivity" />
    </shortcut>
</shortcuts>
