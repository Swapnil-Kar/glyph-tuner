<?xml version="1.0" encoding="utf-8"?>
<!--
  The home screen widget: a grey pill like the launcher's search bar. Left, a dotted button
  (play sign when off, red dot while listening). Middle, the title in the Glyph's dot font and
  what a tap does. Right, the strings, each with a dot that lights up once it is in tune.
  TunerWidget fills it in; the values here are the "off" look, used for the picker preview.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_bar_bg"
        android:contentDescription="@string/widget_start"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="11dp"
        android:paddingEnd="18dp">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ring_off" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:importantForAccessibility="no"
                android:scaleType="fitStart"
                android:src="@drawable/widget_title_tuner" />

            <TextView
                android:id="@+id/widget_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_tap_start"
                android:textColor="#FF9A9A9A"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_strings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_s0"
                android:layout_width="19dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_l0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="E"
                    android:textColor="#FF6A6A6A"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_d0"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot_off" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_s1"
                android:layout_width="19dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_l1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="A"
                    android:textColor="#FF6A6A6A"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_d1"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot_off" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_s2"
                android:layout_width="19dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_l2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="D"
                    android:textColor="#FF6A6A6A"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_d2"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot_off" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_s3"
                android:layout_width="19dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_l3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="G"
                    android:textColor="#FF6A6A6A"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_d3"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot_off" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_s4"
                android:layout_width="19dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_l4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="B"
                    android:textColor="#FF6A6A6A"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_d4"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot_off" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_s5"
                android:layout_width="19dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_l5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="e"
                    android:textColor="#FF6A6A6A"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_d5"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot_off" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
